---
import Layout from '../layouts/Layout.astro';
import FaqList from '../components/FaqList.astro';
import QuoteCTA from '../components/QuoteCTA.astro';
import WhatsAppQuoteForm from '../components/WhatsAppQuoteForm.astro';
import { faqsData } from '../data/faqs';
import { siteData } from '../data/site';

const cocFaqs = faqsData.filter(f => f.category === 'coc' || f.category === 'fencing');
---

<Layout
  title={`Electric Fence COC Certification | ${siteData.companyName}`}
  description="Ensure legal compliance and safety standards with certified Electric Fence System Certificates of Compliance (EFSCOC)."
>
  <div class="page-header">
    <div class="container">
      <span class="header-badge">Compliance &amp; Safety</span>
      <h1 class="page-title">Electric Fence COC Certification</h1>
      <p class="page-lead">
        Official Electric Fence System Certificates of Compliance (EFSCOC) for home sales, property transfers, estate compliance, and insurance peace of mind.
      </p>
    </div>
  </div>

  <section class="coc-section">
    <div class="container coc-grid">
      <div class="coc-main">
        <h2 class="subhead">Why Is an Electric Fence COC Essential?</h2>
        <p>
          In South Africa, the Electrical Machinery Regulations (under the Occupational Health and Safety Act) stipulate that electric fence installations must possess a valid Electric Fence System Certificate of Compliance (EFSCOC).
        </p>
        <p>
          Property transfers frequently require a valid certificate, and insurance underwriters may request proof of compliance during property claims or security audits.
        </p>

        <div class="requirements-box">
          <h3 class="req-title">What Is Assessed During Inspection:</h3>
          <ul class="req-list">
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--colour-gold-deep)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>SABS/SANS 60335-2-76 approved energizers with rated output limits</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--colour-gold-deep)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Adequate earth spike placement (correct array spacing and earthing)</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--colour-gold-deep)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Correct mounting height (minimum 1.5m above ground level on boundary walls)</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--colour-gold-deep)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Clear, high-visibility warning signage installed at mandatory intervals</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--colour-gold-deep)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Isolated cut-out switches and safe gateway pathway clearances</span>
            </li>
          </ul>
        </div>

        <h2 class="subhead mt-large">Inspection &amp; Certification Process</h2>
        <ol class="step-list">
          <li>
            <strong>On-Site Technical Audit:</strong> Our registered installer conducts a full physical inspection of energizers, wire tension, earth array, and warning signs.
          </li>
          <li>
            <strong>Rectification Work (If Required):</strong> If non-compliant faults or earth leaks are detected, we provide a transparent quote for necessary repairs.
          </li>
          <li>
            <strong>EFSCOC Certificate Issuance:</strong> Once the installation satisfies statutory SANS standards, an official Certificate of Compliance is issued.
          </li>
        </ol>
      </div>

      <div class="coc-form-col">
        <WhatsAppQuoteForm
          title="Book a COC Inspection"
          subtitle="Request an on-site electric fence compliance evaluation for property transfer or peace of mind."
          defaultServiceSlug="electric-fencing"
        />
      </div>
    </div>
  </section>

  <section class="coc-faq-section">
    <div class="container">
      <h2 class="subhead text-center">Electric Fence Compliance FAQs</h2>
      <div class="faq-wrap">
        <FaqList faqs={cocFaqs} />
      </div>
    </div>
  </section>

  <QuoteCTA title="Need an Electric Fence COC Urgently?" subtitle="Contact our technical team today to schedule an inspection before transfer or sale." />
</Layout>

<style>
  .page-header {
    background-color: var(--colour-charcoal);
    color: var(--colour-white);
    padding: 4.5rem 0 3.5rem 0;
    border-bottom: 2px solid var(--colour-gold);
  }

  .header-badge {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--colour-gold-bright);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .page-lead {
    font-size: 1.15rem;
    color: var(--colour-silver);
    max-width: 680px;
  }

  .coc-section {
    padding: 4.5rem 0;
    background-color: var(--colour-white);
  }

  .coc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
  }

  @media (min-width: 992px) {
    .coc-grid {
      grid-template-columns: 14fr 10fr;
      align-items: start;
    }
  }

  .subhead {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--colour-ink);
    margin-bottom: 1rem;
  }

  .mt-large {
    margin-top: 2.5rem;
  }

  .coc-main p {
    font-size: 1.05rem;
    color: var(--colour-text);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .requirements-box {
    background-color: var(--colour-paper);
    border: 1px solid var(--colour-line);
    border-left: 4px solid var(--colour-gold);
    border-radius: var(--radius-card);
    padding: 1.75rem;
    margin: 2rem 0;
  }

  .req-title {
    font-size: 1.35rem;
    color: var(--colour-ink);
    margin-bottom: 1rem;
  }

  .req-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .req-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.975rem;
    color: var(--colour-text);
  }

  .req-list svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .step-list {
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 1.025rem;
    color: var(--colour-text);
  }

  .coc-faq-section {
    padding: 4.5rem 0;
    background-color: var(--colour-paper);
  }

  .text-center {
    text-align: center;
  }

  .faq-wrap {
    max-width: 800px;
    margin: 2rem auto 0 auto;
  }
</style>
