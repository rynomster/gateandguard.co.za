---
import Layout from '../layouts/Layout.astro';
import QuoteCTA from '../components/QuoteCTA.astro';
import WhatsAppQuoteForm from '../components/WhatsAppQuoteForm.astro';
import { siteData } from '../data/site';
import { path } from '../utils/paths';

const diyKits = [
  {
    title: "Sliding Gate Motor Hardware Supply",
    desc: "Motor unit, pre-programmed remotes, battery backup, base plate, and gear rack sections.",
    brand: "Centurion / ET Nice"
  },
  {
    title: "Wall-Top Electric Fence Starter Pack",
    desc: "Mains/battery energizer box, 8-strand brackets, high-tensile wire roll, tensioners, and warning signs.",
    brand: "Nemtek / Stafix"
  },
  {
    title: "Plug-and-Play HD CCTV Camera Set",
    desc: "4-Channel NVR recorder, 4 full-color night vision IP cameras, pre-crimped cables, and mobile app guide.",
    brand: "Hikvision / Uniview"
  },
  {
    title: "Wireless Alarm Starter Pack",
    desc: "Control panel, wireless keypad, outdoor beams, indoor passives, and loud siren.",
    brand: "Paradox / IDS"
  }
];
---

<Layout
  title={`DIY Security Hardware Supply & Guided Advice | ${siteData.companyName}`}
  description="Supply-only security hardware, pre-configured gate motor packages, electric fence bundles, and telephonic technical guidance."
>
  <div class="page-header">
    <div class="container">
      <span class="header-badge">Supply Only &amp; Guided Setup</span>
      <h1 class="page-title">DIY Security Supply &amp; Technical Support</h1>
      <p class="page-lead">
        Quality pre-programmed equipment bundles, supply-only hardware, and expert guidance for handy homeowners, property managers, and farm owners.
      </p>
    </div>
  </div>

  <section class="diy-section">
    <div class="container diy-grid">
      <div class="diy-main">
        <h2 class="subhead">Handy Homeowner &amp; Guided DIY Solutions</h2>
        <p>
          Not every project requires a full installation crew. If you possess electrical and mechanical trade experience, <strong>{siteData.companyName}</strong> supplies pre-configured hardware packages paired with telephonic and WhatsApp technical support.
        </p>

        <div class="kits-grid">
          {diyKits.map((kit) => (
            <div class="kit-card">
              <span class="brand-tag">{kit.brand}</span>
              <h3 class="kit-title">{kit.title}</h3>
              <p class="kit-desc">{kit.desc}</p>
              <a href={path('/contact#quote')} class="btn-text">
                <span>Inquire Supply Pricing</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </a>
            </div>
          ))}
        </div>

        <div class="support-notice">
          <h3>Need On-Site Technician Handover?</h3>
          <p>
            If you encounter physical mounting hurdles or need assistance wiring a complex motor controller, our technicians can take over on-site for commissioning and compliance checks.
          </p>
        </div>
      </div>

      <div class="diy-form-col">
        <WhatsAppQuoteForm
          title="Inquire DIY Hardware Supply"
          subtitle="Tell us which equipment kit or motor replacement parts you need, and we'll reply with availability and pricing."
          defaultServiceSlug="diy-projects"
        />
      </div>
    </div>
  </section>

  <QuoteCTA title="Need Equipment Supply or Advice?" subtitle="Contact our technical team for hardware availability and pre-programmed security bundles." />
</Layout>

<style>
  .page-header {
    background-color: var(--colour-charcoal);
    color: var(--colour-white);
    padding: 4.5rem 0 3.5rem 0;
    border-bottom: 2px solid var(--colour-gold);
  }

  .header-badge {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--colour-gold-bright);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .page-lead {
    font-size: 1.15rem;
    color: var(--colour-silver);
    max-width: 680px;
  }

  .diy-section {
    padding: 4.5rem 0;
    background-color: var(--colour-white);
  }

  .diy-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
  }

  @media (min-width: 992px) {
    .diy-grid {
      grid-template-columns: 14fr 10fr;
      align-items: start;
    }
  }

  .subhead {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--colour-ink);
    margin-bottom: 1rem;
  }

  .diy-main p {
    font-size: 1.05rem;
    color: var(--colour-text);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .kits-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 768px) {
    .kits-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .kit-card {
    background-color: var(--colour-paper);
    border: 1px solid var(--colour-line);
    border-radius: var(--radius-card);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .brand-tag {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--colour-gold-deep);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .kit-title {
    font-size: 1.25rem;
    color: var(--colour-ink);
    margin-bottom: 0.5rem;
  }

  .kit-desc {
    font-size: 0.925rem;
    color: var(--colour-muted);
    line-height: 1.5;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .support-notice {
    background-color: var(--colour-paper);
    border: 1px solid var(--colour-line);
    border-left: 4px solid var(--colour-gold);
    border-radius: var(--radius-card);
    padding: 1.75rem;
  }

  .support-notice h3 {
    font-size: 1.35rem;
    color: var(--colour-ink);
    margin-bottom: 0.5rem;
  }

  .support-notice p {
    font-size: 0.975rem;
    color: var(--colour-muted);
    margin-bottom: 0;
  }
</style>
