---
import Layout from '../../layouts/Layout.astro';
import FaqList from '../../components/FaqList.astro';
import WhatsAppQuoteForm from '../../components/WhatsAppQuoteForm.astro';
import QuoteCTA from '../../components/QuoteCTA.astro';

import { servicesData } from '../../data/services';
import { siteData } from '../../data/site';
import { path } from '../../utils/paths';

export function getStaticPaths() {
  return servicesData.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<Layout
  title={`${service.title} | ${siteData.companyName}`}
  description={service.summary}
>
  <!-- Service Hero -->
  <div class="service-hero">
    <div class="service-hero-media">
      <img
        src={path(service.heroImage)}
        alt={service.title}
        width="1200"
        height="600"
        fetchpriority="high"
        loading="eager"
        class="service-hero-img"
      />
      <div class="service-hero-overlay"></div>
    </div>

    <div class="container service-hero-container">
      <div class="service-hero-content">
        <a href={path('/services')} class="back-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          <span>All Services</span>
        </a>
        <h1 class="service-title">{service.title}</h1>
        <p class="service-lead">{service.summary}</p>

        <div class="hero-cta-row">
          <a href={path(`/contact?service=${encodeURIComponent(service.slug)}#quote`)} class="btn-primary">
            <span>Get a Quote for {service.shortTitle}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Service Detail Body -->
  <section class="service-body-section">
    <div class="container service-grid">
      <div class="service-main">
        <h2 class="subhead">Overview</h2>
        <p class="description-text">{service.description}</p>

        <h2 class="subhead mt-large">Key Capabilities &amp; Features</h2>
        <div class="features-grid">
          {service.features.map((feature) => (
            <div class="feature-card">
              <div class="feature-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--colour-gold-deep)" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <span>{feature}</span>
            </div>
          ))}
        </div>

        <h2 class="subhead mt-large">Typical Applications</h2>
        <ul class="applications-list">
          {service.useCases.map((useCase) => (
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--colour-gold-deep)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>{useCase}</span>
            </li>
          ))}
        </ul>

        {service.supportedBrands && service.supportedBrands.length > 0 && (
          <div class="brands-box">
            <h4>Supported &amp; Installed Brands</h4>
            <div class="brand-tags">
              {service.supportedBrands.map((brand) => (
                <span class="brand-chip">{brand}</span>
              ))}
            </div>
          </div>
        )}

        {service.faqs && service.faqs.length > 0 && (
          <div class="service-faq-block mt-large">
            <h2 class="subhead">Service FAQs</h2>
            <FaqList faqs={service.faqs.map(f => ({ ...f, category: 'general' }))} />
          </div>
        )}
      </div>

      <!-- Sidebar Quote Form -->
      <div class="service-sidebar">
        <WhatsAppQuoteForm
          title={`Quote: ${service.shortTitle}`}
          subtitle={`Request a fast quote for ${service.title.toLowerCase()}.`}
          defaultServiceSlug={service.slug}
        />
      </div>
    </div>
  </section>

  <QuoteCTA
    title={`Ready to Upgrade Your ${service.shortTitle}?`}
    subtitle="Contact Gate & Guard Projects today to discuss your site specifications and obtain an estimate."
  />
</Layout>

<style>
  .service-hero {
    position: relative;
    background-color: var(--colour-charcoal);
    padding: 5rem 0 4rem 0;
    border-bottom: 2px solid var(--colour-gold);
    overflow: hidden;
  }

  .service-hero-media {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .service-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.85);
  }

  .service-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(10, 14, 18, 0.95) 0%, rgba(10, 14, 18, 0.85) 50%, rgba(10, 14, 18, 0.5) 100%);
  }

  .service-hero-container {
    position: relative;
    z-index: 2;
  }

  .service-hero-content {
    max-width: 720px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--colour-gold-bright);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
  }

  .back-link:hover {
    color: var(--colour-white);
  }

  .service-title {
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    font-weight: 800;
    color: var(--colour-white);
    line-height: 1.05;
    margin-bottom: 1rem;
  }

  .service-lead {
    font-size: 1.15rem;
    color: var(--colour-silver);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .service-body-section {
    padding: 4.5rem 0;
    background-color: var(--colour-white);
  }

  .service-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
  }

  @media (min-width: 992px) {
    .service-grid {
      grid-template-columns: 14fr 10fr;
      align-items: start;
    }
  }

  .subhead {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--colour-ink);
    margin-bottom: 1rem;
  }

  .mt-large {
    margin-top: 2.5rem;
  }

  .description-text {
    font-size: 1.075rem;
    color: var(--colour-text);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .feature-card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    background-color: var(--colour-paper);
    border: 1px solid var(--colour-line);
    border-radius: var(--radius-control);
    padding: 1rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--colour-ink);
  }

  .feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .applications-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 2rem;
  }

  .applications-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 1rem;
    color: var(--colour-text);
  }

  .applications-list svg {
    flex-shrink: 0;
    margin-top: 3px;
  }

  .brands-box {
    background-color: var(--colour-paper);
    border: 1px solid var(--colour-line);
    border-left: 4px solid var(--colour-gold);
    border-radius: var(--radius-card);
    padding: 1.5rem;
    margin: 2.5rem 0;
  }

  .brands-box h4 {
    font-size: 1.15rem;
    color: var(--colour-ink);
    margin-bottom: 0.85rem;
  }

  .brand-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .brand-chip {
    background-color: var(--colour-white);
    border: 1px solid var(--colour-line);
    padding: 0.35rem 0.85rem;
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--colour-ink);
  }
</style>
