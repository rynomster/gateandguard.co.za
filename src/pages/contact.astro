---
import Layout from '../layouts/Layout.astro';
import WhatsAppQuoteForm from '../components/WhatsAppQuoteForm.astro';
import FaqList from '../components/FaqList.astro';
import { siteData } from '../data/site';
import { faqsData } from '../data/faqs';

const generalFaqs = faqsData.filter(f => f.category === 'general' || f.category === 'automation');
---

<Layout
  title={`Contact & Fast Quote Request | ${siteData.companyName}`}
  description="Get in touch with Gate & Guard Projects for fast security quotes, gate motor repairs, electric fencing COCs, and CCTV installations in Gauteng."
>
  <div class="page-header">
    <div class="container">
      <span class="header-badge">Get In Touch</span>
      <h1 class="page-title">Contact &amp; Request a Quote</h1>
      <p class="page-lead">
        Send us a quick message via WhatsApp or call our team directly for site visits, system repairs, and instant estimates across Gauteng.
      </p>
    </div>
  </div>

  <section class="contact-section">
    <div class="container contact-grid">
      <!-- Contact Info Column -->
      <div class="contact-info-col">
        <h2 class="subhead">Direct Contact Details</h2>
        <p class="intro-p">
          We pride ourselves on rapid response times and direct technician communication.
        </p>

        <div class="info-cards">
          <div class="info-card">
            <div class="card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            </div>
            <div class="card-text">
              <h4>Telephone Contact</h4>
              <p><a href={`tel:${siteData.phone}`}>{siteData.phoneFormatted}</a></p>
            </div>
          </div>

          <div class="info-card">
            <div class="card-icon wa-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
            </div>
            <div class="card-text">
              <h4>Instant WhatsApp</h4>
              <p><a href={`https://wa.me/${siteData.whatsapp}`} target="_blank" rel="noopener noreferrer">{siteData.whatsappFormatted}</a></p>
            </div>
          </div>

          <div class="info-card">
            <div class="card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </div>
            <div class="card-text">
              <h4>Email Enquiries</h4>
              <p><a href={`mailto:${siteData.email}`}>{siteData.email}</a></p>
            </div>
          </div>

          <div class="info-card">
            <div class="card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <div class="card-text">
              <h4>Operating Hours</h4>
              <p>Mon - Fri: {siteData.businessHours.weekdays}</p>
              <p>Sat: {siteData.businessHours.saturday}</p>
              <p>Sun: {siteData.businessHours.sunday}</p>
            </div>
          </div>
        </div>

        <div class="serviced-areas-block">
          <h3 class="block-title">Key Areas Serviced</h3>
          <p class="areas-text">
            {siteData.serviceAreas.join(' • ')} and surrounding Gauteng suburbs.
          </p>
        </div>

        <div class="faq-block">
          <h3 class="block-title">Common Questions</h3>
          <FaqList faqs={generalFaqs} />
        </div>
      </div>

      <!-- Form Column -->
      <div class="contact-form-col">
        <WhatsAppQuoteForm />
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background-color: var(--colour-charcoal);
    color: var(--colour-white);
    padding: 4rem 0 3.5rem 0;
    border-bottom: 2px solid var(--colour-gold);
  }

  .header-badge {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--colour-gold-bright);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .page-lead {
    font-size: 1.15rem;
    color: var(--colour-silver);
    max-width: 750px;
    line-height: 1.6;
  }

  .contact-section {
    padding: 4rem 0;
    background-color: var(--colour-paper);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 992px) {
    .contact-grid {
      grid-template-columns: 1fr 1.1fr;
    }
  }

  .subhead {
    font-family: var(--font-heading);
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--colour-ink);
    margin-bottom: 0.5rem;
  }

  .intro-p {
    font-size: 1rem;
    color: var(--colour-muted);
    margin-bottom: 2rem;
  }

  .info-cards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .info-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background-color: var(--colour-white);
    border: 1px solid var(--colour-line);
    border-radius: var(--radius-sm);
    padding: 1rem 1.25rem;
  }

  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background-color: var(--colour-paper);
    color: var(--colour-gold-dark);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .card-icon.wa-icon {
    background-color: rgba(37, 211, 102, 0.15);
    color: #25d366;
  }

  .card-text h4 {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--colour-ink);
    margin-bottom: 0.15rem;
  }

  .card-text p {
    font-size: 0.9rem;
    color: var(--colour-text);
    margin: 0;
  }

  .serviced-areas-block {
    background-color: var(--colour-white);
    border: 1px solid var(--colour-line);
    border-left: 4px solid var(--colour-gold);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .block-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--colour-ink);
    margin-bottom: 0.5rem;
  }

  .areas-text {
    font-size: 0.9rem;
    color: var(--colour-text);
    line-height: 1.6;
    margin: 0;
  }

  .faq-block {
    margin-top: 2.5rem;
  }
</style>
