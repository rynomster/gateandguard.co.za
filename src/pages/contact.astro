---
import Layout from '../layouts/Layout.astro';
import WhatsAppQuoteForm from '../components/WhatsAppQuoteForm.astro';
import FaqList from '../components/FaqList.astro';
import { siteData } from '../data/site';
import { faqsData } from '../data/faqs';

const generalFaqs = faqsData.filter(f => f.category === 'general' || f.category === 'automation');
---

<Layout
  title={`Contact & Fast Quote Request | ${siteData.companyName}`}
  description="Contact Gate & Guard Projects for security quotes, gate motor repairs, electric fencing COCs, and CCTV installations."
>
  <div class="page-header">
    <div class="container">
      <span class="header-badge">Get In Touch</span>
      <h1 class="page-title">Contact &amp; Request a Quote</h1>
      <p class="page-lead">
        Send us a quick message via WhatsApp or call our team directly for site visits, system repairs, and instant estimates.
      </p>
    </div>
  </div>

  <section class="contact-section">
    <div class="container contact-grid">
      <!-- Contact Info Column -->
      <div class="contact-info-col">
        <h2 class="subhead">Direct Contact Details</h2>
        <p class="intro-p">
          We pride ourselves on prompt response times and direct technician communication.
        </p>

        <div class="info-cards">
          <div class="info-card">
            <div class="card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            </div>
            <div class="card-text">
              <h4>Telephone Contact</h4>
              <p><a href={`tel:${siteData.phone}`} data-analytics="phone_click" data-placement="contact_page">{siteData.phoneFormatted}</a></p>
            </div>
          </div>

          <div class="info-card">
            <div class="card-icon wa-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
            </div>
            <div class="card-text">
              <h4>Instant WhatsApp</h4>
              <p><a href={`https://wa.me/${siteData.whatsapp}?text=Hello%20Gate%20%26%20Guard%20Projects,%20I%20would%20like%20to%20request%20a%20quote.`} target="_blank" rel="noopener noreferrer" data-analytics="whatsapp_click" data-placement="contact_page">{siteData.whatsappFormatted}</a></p>
            </div>
          </div>

          <div class="info-card">
            <div class="card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </div>
            <div class="card-text">
              <h4>Email Enquiries</h4>
              <p><a href={`mailto:${siteData.email}`} data-analytics="email_click" data-placement="contact_page">{siteData.email}</a></p>
            </div>
          </div>

          <div class="info-card">
            <div class="card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <div class="card-text">
              <h4>Business Operating Hours</h4>
              <p>Mon - Fri: {siteData.businessHours.weekdays}</p>
              <p>Saturday: {siteData.businessHours.saturday}</p>
              <p>Sunday: {siteData.businessHours.sunday}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Quote Form Column -->
      <div class="contact-form-col" id="quote">
        <WhatsAppQuoteForm />
      </div>
    </div>
  </section>

  <section class="contact-faq-section">
    <div class="container">
      <h2 class="subhead text-center">Frequently Asked Questions</h2>
      <div class="faq-wrap">
        <FaqList faqs={generalFaqs} />
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background-color: var(--colour-charcoal);
    color: var(--colour-white);
    padding: 4.5rem 0 3.5rem 0;
    border-bottom: 2px solid var(--colour-gold);
  }

  .header-badge {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--colour-gold-bright);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .page-lead {
    font-size: 1.15rem;
    color: var(--colour-silver);
    max-width: 680px;
  }

  .contact-section {
    padding: 4.5rem 0;
    background-color: var(--colour-white);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
  }

  @media (min-width: 992px) {
    .contact-grid {
      grid-template-columns: 10fr 14fr;
      align-items: start;
    }
  }

  .subhead {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--colour-ink);
    margin-bottom: 0.75rem;
  }

  .intro-p {
    font-size: 1.05rem;
    color: var(--colour-muted);
    margin-bottom: 2rem;
  }

  .info-cards {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .info-card {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.25rem;
    background-color: var(--colour-paper);
    border: 1px solid var(--colour-line);
    border-radius: var(--radius-card);
  }

  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background-color: var(--colour-charcoal);
    color: var(--colour-gold-bright);
    border-radius: var(--radius-control);
    flex-shrink: 0;
  }

  .wa-icon {
    background-color: #25d366;
    color: #ffffff;
  }

  .card-text h4 {
    font-size: 1.1rem;
    color: var(--colour-ink);
    margin-bottom: 0.25rem;
  }

  .card-text p {
    font-size: 0.95rem;
    color: var(--colour-text);
    margin-bottom: 0.15rem;
  }

  .card-text a {
    color: var(--colour-gold-deep);
    font-weight: 600;
  }

  .card-text a:hover {
    color: var(--colour-gold);
  }

  .contact-faq-section {
    padding: 4.5rem 0;
    background-color: var(--colour-paper);
  }

  .text-center {
    text-align: center;
  }

  .faq-wrap {
    max-width: 800px;
    margin: 2rem auto 0 auto;
  }
</style>
