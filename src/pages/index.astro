---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TrustWhyChooseUs from '../components/TrustWhyChooseUs.astro';
import SaferTomorrow from '../components/SaferTomorrow.astro';
import QuoteCTA from '../components/QuoteCTA.astro';
import FaqList from '../components/FaqList.astro';
import WhatsAppQuoteForm from '../components/WhatsAppQuoteForm.astro';

import { servicesData } from '../data/services';
import { faqsData } from '../data/faqs';
import { siteData } from '../data/site';
import { path } from '../utils/paths';

// Filter primary services (exclude DIY from main 6 grid, keep DIY separate)
const primaryServices = servicesData.filter(s => s.slug !== 'diy-projects');
const generalFaqs = faqsData.filter(f => f.category === 'general' || f.category === 'automation');
---

<Layout
  title={`${siteData.companyName} | Security, Gate Automation & Access Control`}
  description="Precision gate automation, electric fencing, CCTV surveillance, and access control for South African residential homes, estates, and commercial premises."
>
  <!-- Hero Section -->
  <Hero />

  <!-- Trust Value Bar -->
  <TrustStrip />

  <!-- Core Services Section (White Background) -->
  <section class="section-services">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Solutions &amp; Systems</span>
        <h2 class="section-title">Protect What Matters. Make Access Effortless.</h2>
        <p class="section-lead">
          From heavy-duty sliding gate motors to high-voltage electric perimeters and 4K CCTV surveillance, we engineer complete protection tailored for your property.
        </p>
      </div>

      <div class="services-grid">
        {primaryServices.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>

      <!-- DIY Supply Callout Banner -->
      <div class="diy-callout-banner">
        <div class="diy-banner-content">
          <span class="diy-badge">Supply &amp; Self-Install</span>
          <h3>Prefer DIY Security Setup?</h3>
          <p>We supply pre-programmed gate motor packages, electric fence energizers, and CCTV hardware with guided phone and WhatsApp technical support.</p>
        </div>
        <a href={path('/diy-projects')} class="btn-secondary btn-secondary-light">
          <span>View DIY Hardware Supply</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Mid-Page Editorial Feature Block (Charcoal Background) -->
  <SaferTomorrow />

  <!-- Proof & Advantage Section (Paper Light Background) -->
  <TrustWhyChooseUs />

  <!-- FAQ & Quick Quote Section (White Background) -->
  <section class="section-faq-form">
    <div class="container grid-faq-form">
      <div class="faq-col">
        <span class="section-eyebrow">Frequently Asked Questions</span>
        <h2 class="section-title">Clear Answers Before You Quote</h2>
        <p class="faq-intro">
          Got questions about battery backup cycles, load-shedding resilience, or Electric Fence COCs? We provide transparent guidance.
        </p>
        <FaqList faqs={generalFaqs} />
      </div>

      <div class="form-col" id="quote-form-block">
        <WhatsAppQuoteForm
          title="Request a Fast Quote"
          subtitle="Select your required security service and receive an estimate directly via WhatsApp or email."
        />
      </div>
    </div>
  </section>

  <!-- Final Lead CTA Banner -->
  <QuoteCTA
    title="Ready to Fortify Your Property Line?"
    subtitle="Contact our technical team today for a transparent, no-obligation evaluation and quote."
  />
</Layout>

<style>
  .section-services {
    padding: 5rem 0;
    background-color: var(--colour-white);
  }

  @media (min-width: 992px) {
    .section-services {
      padding: 7rem 0;
    }
  }

  .section-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 3.5rem auto;
  }

  .section-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--colour-gold-deep);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 800;
    color: var(--colour-ink);
    margin-bottom: 1rem;
    line-height: 1.1;
  }

  .section-lead {
    font-size: 1.125rem;
    color: var(--colour-muted);
    line-height: 1.6;
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* DIY Banner */
  .diy-callout-banner {
    margin-top: 4rem;
    background-color: var(--colour-paper);
    border: 1px solid var(--colour-line);
    border-left: 4px solid var(--colour-gold);
    border-radius: var(--radius-card);
    padding: 2rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .diy-callout-banner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .diy-badge {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--colour-gold-deep);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: inline-block;
    margin-bottom: 0.35rem;
  }

  .diy-banner-content h3 {
    font-size: 1.5rem;
    color: var(--colour-ink);
    margin-bottom: 0.5rem;
  }

  .diy-banner-content p {
    color: var(--colour-muted);
    font-size: 0.975rem;
    max-width: 680px;
    margin-bottom: 0;
  }

  /* FAQ & Form Section */
  .section-faq-form {
    padding: 5rem 0;
    background-color: var(--colour-paper);
  }

  @media (min-width: 992px) {
    .section-faq-form {
      padding: 7rem 0;
    }
  }

  .grid-faq-form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
  }

  @media (min-width: 992px) {
    .grid-faq-form {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .faq-intro {
    font-size: 1.05rem;
    color: var(--colour-muted);
    margin-bottom: 2rem;
  }
</style>
