---
import { assetRegistry } from '../data/assets';
import { path } from '../utils/paths';

const featureAsset = assetRegistry.serviceAutomation;
---

<section class="editorial-feature-section">
  <div class="container">
    <div class="editorial-grid">
      <!-- Media Column -->
      <div class="editorial-media">
        <img
          src={path(featureAsset.path)}
          alt={featureAsset.alt}
          width="800"
          height="600"
          loading="lazy"
          class="editorial-img"
        />
        <div class="editorial-media-badge">
          <span class="badge-accent"></span>
          <span>Integrated Protection &amp; Access</span>
        </div>
      </div>

      <!-- Text Content Column -->
      <div class="editorial-content">
        <span class="feature-eyebrow">Seamless Perimeter Engineering</span>
        <h2 class="feature-title">Engineered to Protect. Built to Last.</h2>
        <p class="feature-lead">
          A truly effective security system is more than isolated equipment. It is a synchronized defense network designed around your property's real physical layout.
        </p>

        <div class="feature-points">
          <div class="point-item">
            <div class="point-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--colour-gold-bright)" stroke-width="2.5"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
            </div>
            <div class="point-text">
              <h4>Multi-Layered Defense Line</h4>
              <p>Combining high-voltage electric perimeters, early-warning outdoor beams, and high-speed gate automation so breaches are deterred before entry.</p>
            </div>
          </div>

          <div class="point-item">
            <div class="point-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--colour-gold-bright)" stroke-width="2.5"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
            </div>
            <div class="point-text">
              <h4>Load-Shedding &amp; Outage Resilience</h4>
              <p>Equipped with deep-cycle AGM or lithium battery backups engineered to withstand extended South African power outages without compromising safety.</p>
            </div>
          </div>

          <div class="point-item">
            <div class="point-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--colour-gold-bright)" stroke-width="2.5"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
            </div>
            <div class="point-text">
              <h4>Smart Mobile App Integration</h4>
              <p>Receive instant trip notifications, view live HD CCTV feeds, and open your entrance gate remotely from anywhere on your smartphone.</p>
            </div>
          </div>
        </div>

        <div class="editorial-actions">
          <a href={path('/contact#quote')} class="btn-primary" data-analytics="quote_cta_click" data-placement="editorial_feature">
            <span>Request System Quote</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
          <a href={path('/coc-certification')} class="btn-secondary">
            <span>Electric Fence COC Info</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .editorial-feature-section {
    padding: 5.5rem 0;
    background-color: var(--colour-charcoal);
    color: var(--colour-silver-light);
    position: relative;
    border-top: 1px solid var(--colour-line-dark);
    border-bottom: 1px solid var(--colour-line-dark);
  }

  @media (min-width: 992px) {
    .editorial-feature-section {
      padding: 7.5rem 0;
    }
  }

  .editorial-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 992px) {
    .editorial-grid {
      grid-template-columns: 11fr 13fr;
    }
  }

  /* Media Column */
  .editorial-media {
    position: relative;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.4);
    border: 1px solid var(--colour-line-dark);
    aspect-ratio: 4 / 3;
  }

  .editorial-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .editorial-media-badge {
    position: absolute;
    bottom: 1.25rem;
    left: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background-color: rgba(18, 24, 32, 0.9);
    border: 1px solid rgba(223, 170, 53, 0.4);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--colour-gold-bright);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    backdrop-filter: blur(6px);
  }

  .badge-accent {
    width: 8px;
    height: 8px;
    background-color: var(--colour-gold-bright);
    border-radius: 50%;
  }

  /* Text Column */
  .feature-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--colour-gold-bright);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.5rem;
  }

  .feature-title {
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    font-weight: 800;
    color: var(--colour-white);
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .feature-lead {
    font-size: 1.125rem;
    color: var(--colour-silver);
    line-height: 1.6;
    margin-bottom: 2.25rem;
  }

  .feature-points {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .point-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .point-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background-color: var(--colour-panel);
    border: 1px solid var(--colour-line-dark);
    border-radius: var(--radius-control);
    flex-shrink: 0;
  }

  .point-text h4 {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--colour-white);
    letter-spacing: 0.02em;
    margin-bottom: 0.25rem;
  }

  .point-text p {
    font-size: 0.95rem;
    color: var(--colour-silver);
    line-height: 1.5;
    margin-bottom: 0;
  }

  .editorial-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>
