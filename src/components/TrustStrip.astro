---
import { siteData } from '../data/site';
---

<section class="trust-strip">
  <div class="container trust-grid">
    {siteData.trustStripItems.map((item) => (
      <div class="trust-item">
        <div class="trust-icon">
          {item.icon === 'home' && (
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--colour-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
          )}
          {item.icon === 'building' && (
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--colour-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><path d="M9 22v-4h6v4"></path><path d="M8 6h.01"></path><path d="M16 6h.01"></path><path d="M12 6h.01"></path><path d="M12 10h.01"></path><path d="M12 14h.01"></path><path d="M16 10h.01"></path><path d="M16 14h.01"></path><path d="M8 10h.01"></path><path d="M8 14h.01"></path></svg>
          )}
          {item.icon === 'shield' && (
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--colour-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          )}
          {item.icon === 'flag' && (
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--colour-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path><line x1="4" y1="22" x2="4" y2="15"></line></svg>
          )}
        </div>
        <div class="trust-text">
          <h3 class="trust-title">{item.title}</h3>
          <p class="trust-sub">{item.subtitle}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .trust-strip {
    background-color: var(--colour-charcoal);
    border-bottom: 1px solid var(--colour-line-dark);
    padding: 1.5rem 0;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .trust-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    background-color: var(--colour-panel);
    border: 1px solid var(--colour-line-dark);
    border-radius: var(--radius-sm);
  }

  .trust-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background-color: rgba(217, 154, 27, 0.12);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .trust-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--colour-white);
    line-height: 1.2;
    letter-spacing: 0.03em;
  }

  .trust-sub {
    font-size: 0.8125rem;
    color: var(--colour-silver);
    margin: 0;
  }
</style>
