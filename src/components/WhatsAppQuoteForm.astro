---
import { siteData } from '../data/site';
import { servicesData } from '../data/services';
---

<div class="whatsapp-quote-card" id="quote">
  <div class="form-header">
    <h3 class="form-title">Request a Free Quote</h3>
    <p class="form-sub">Fill in your details below to generate an instant WhatsApp request or fallback call/email.</p>
  </div>

  <form id="wa-quote-form" class="quote-form" action="#">
    <div class="form-group">
      <label for="q-name">Your Full Name <span class="req">*</span></label>
      <input type="text" id="q-name" name="name" required placeholder="e.g. Johan Smith" class="form-control" />
    </div>

    <div class="form-group">
      <label for="q-phone">Phone / Contact Number <span class="req">*</span></label>
      <input type="tel" id="q-phone" name="phone" required placeholder="e.g. 082 123 4567" class="form-control" />
    </div>

    <div class="form-group">
      <label for="q-area">Suburb / Area in Gauteng <span class="req">*</span></label>
      <input type="text" id="q-area" name="area" required placeholder="e.g. Sandton, Randburg, Centurion" class="form-control" />
    </div>

    <div class="form-group">
      <label for="q-service">Service Required <span class="req">*</span></label>
      <select id="q-service" name="service" required class="form-control">
        <option value="">Select a service category...</option>
        {servicesData.map((svc) => (
          <option value={svc.shortTitle}>{svc.title}</option>
        ))}
        <option value="General Security Enquiry">General Security & Inspection</option>
      </select>
    </div>

    <div class="form-group">
      <label for="q-message">Brief Description / Notes</label>
      <textarea id="q-message" name="message" rows="3" placeholder="Tell us about your property, motor type, fence repair, or CCTV needs..." class="form-control"></textarea>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn-submit-wa">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
        <span>Send Quote via WhatsApp</span>
      </button>
    </div>
  </form>

  <div class="fallback-actions">
    <p class="fallback-title">Prefer phone or direct email?</p>
    <div class="fallback-buttons">
      <a href={`tel:${siteData.phone}`} class="btn-fallback">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        <span>Call {siteData.phoneFormatted}</span>
      </a>
      <a href={`mailto:${siteData.email}`} class="btn-fallback">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        <span>Email Us</span>
      </a>
    </div>
  </div>
</div>

<style>
  .whatsapp-quote-card {
    background-color: var(--colour-white);
    border: 2px solid var(--colour-gold);
    border-radius: var(--radius-md);
    padding: 2rem;
    box-shadow: var(--shadow-lg);
  }

  .form-header {
    margin-bottom: 1.5rem;
  }

  .form-title {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--colour-ink);
    letter-spacing: 0.02em;
    margin-bottom: 0.35rem;
  }

  .form-sub {
    font-size: 0.925rem;
    color: var(--colour-muted);
  }

  .quote-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  label {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--colour-ink);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .req {
    color: #d9381e;
  }

  .form-control {
    width: 100%;
    padding: 0.75rem 0.85rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    border: 1px solid var(--colour-line);
    border-radius: var(--radius-sm);
    background-color: var(--colour-paper);
    color: var(--colour-text);
  }

  .form-control:focus {
    border-color: var(--colour-gold);
    background-color: var(--colour-white);
    outline: none;
  }

  .btn-submit-wa {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    background-color: #25d366;
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.85rem;
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: background-color var(--transition-fast);
  }

  .btn-submit-wa:hover {
    background-color: #1eb956;
  }

  .fallback-actions {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--colour-line);
    text-align: center;
  }

  .fallback-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--colour-muted);
    margin-bottom: 0.75rem;
  }

  .fallback-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .btn-fallback {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background-color: var(--colour-paper);
    color: var(--colour-text);
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--colour-line);
    border-radius: var(--radius-sm);
  }

  .btn-fallback:hover {
    background-color: var(--colour-white);
    border-color: var(--colour-gold);
    color: var(--colour-gold-dark);
  }
</style>

<script is:inline define:vars={{ whatsappNumber: siteData.whatsapp }}>
  const form = document.getElementById('wa-quote-form');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = document.getElementById('q-name').value.trim();
      const phone = document.getElementById('q-phone').value.trim();
      const area = document.getElementById('q-area').value.trim();
      const service = document.getElementById('q-service').value.trim();
      const message = document.getElementById('q-message').value.trim();

      let text = `Hello Gate & Guard Projects,\n\nI would like to request a quote.\n\n`;
      text += `*Name:* ${name}\n`;
      text += `*Phone:* ${phone}\n`;
      text += `*Area:* ${area}\n`;
      text += `*Service:* ${service}\n`;
      if (message) {
        text += `*Notes:* ${message}\n`;
      }

      const encodedText = encodeURIComponent(text);
      const waUrl = `https://wa.me/${whatsappNumber}?text=${encodedText}`;
      window.open(waUrl, '_blank');
    });
  }
</script>
