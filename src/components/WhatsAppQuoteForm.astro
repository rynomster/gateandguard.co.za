---
import { siteData } from '../data/site';
import { servicesData } from '../data/services';

interface Props {
  title?: string;
  subtitle?: string;
  defaultServiceSlug?: string;
}

const {
  title = "Request a Fast Quote",
  subtitle = "Fill in your details below to generate an instant pre-filled WhatsApp quote request or email enquiry.",
  defaultServiceSlug = ""
} = Astro.props;
---

<div class="quote-form-card">
  <div class="form-header">
    <div class="wa-badge">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
      <span>Instant WhatsApp Quote Funnel</span>
    </div>
    <h3 class="form-title">{title}</h3>
    <p class="form-subtitle">{subtitle}</p>
  </div>

  <form id="whatsapp-quote-form" class="quote-form">
    <!-- Required Service Selection -->
    <div class="form-group">
      <label for="form-service" class="form-label">
        Required Service <span class="required-asterisk">*</span>
      </label>
      <select id="form-service" name="service" class="form-select" required>
        <option value="" disabled selected={!defaultServiceSlug}>Select a security service...</option>
        {servicesData.map((s) => (
          <option value={s.title} selected={defaultServiceSlug === s.slug}>
            {s.title}
          </option>
        ))}
        <option value="General Security Inspection">General Security Assessment</option>
        <option value="Other Custom Enquiry">Other Security Request</option>
      </select>
    </div>

    <!-- Contact Name -->
    <div class="form-group">
      <label for="form-name" class="form-label">
        Your Full Name <span class="required-asterisk">*</span>
      </label>
      <input
        type="text"
        id="form-name"
        name="name"
        class="form-input"
        placeholder="e.g. Johan van der Merwe"
        required
      />
    </div>

    <!-- Phone Number -->
    <div class="form-group">
      <label for="form-phone" class="form-label">
        Contact Phone Number <span class="required-asterisk">*</span>
      </label>
      <input
        type="tel"
        id="form-phone"
        name="phone"
        class="form-input"
        placeholder="e.g. 082 123 4567"
        required
      />
    </div>

    <!-- Area / Suburb -->
    <div class="form-group">
      <label for="form-area" class="form-label">
        Property Area / Suburb <span class="required-asterisk">*</span>
      </label>
      <input
        type="text"
        id="form-area"
        name="area"
        class="form-input"
        placeholder="e.g. Suburb or City"
        required
      />
    </div>

    <!-- Additional Notes -->
    <div class="form-group">
      <label for="form-notes" class="form-label">
        Additional Installation Notes <span class="optional-tag">(Optional)</span>
      </label>
      <textarea
        id="form-notes"
        name="notes"
        class="form-textarea"
        rows="3"
        placeholder="Describe your gate motor model, fence length, or existing security setup..."
      ></textarea>
    </div>

    <!-- Action Buttons -->
    <div class="form-actions">
      <button type="submit" class="btn-primary btn-submit-wa" id="btn-submit-wa" data-analytics="quote_form_whatsapp_handoff">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
        <span>Send via WhatsApp</span>
      </button>

      <a href={`mailto:${siteData.email}`} id="btn-fallback-email" class="btn-secondary btn-secondary-light">
        <span>Email Enquiry Instead</span>
      </a>
    </div>

    <p class="form-disclaimer">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
      Submitting pre-fills a direct WhatsApp message to Gate &amp; Guard Projects. You can review the text before sending.
    </p>
  </form>
</div>

<style>
  .quote-form-card {
    background-color: var(--colour-white);
    border: 1px solid var(--colour-line);
    border-radius: var(--radius-card);
    padding: 2rem;
    box-shadow: var(--shadow-card);
  }

  .form-header {
    margin-bottom: 1.75rem;
  }

  .wa-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background-color: #25d3661a;
    border: 1px solid #25d36680;
    color: #128c7e;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.75rem;
    border-radius: 20px;
    margin-bottom: 0.75rem;
  }

  .form-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--colour-ink);
    margin-bottom: 0.5rem;
  }

  .form-subtitle {
    font-size: 0.95rem;
    color: var(--colour-muted);
    line-height: 1.5;
    margin-bottom: 0;
  }

  .quote-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-label {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--colour-ink);
  }

  .required-asterisk {
    color: #d93838;
  }

  .optional-tag {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--colour-muted);
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    font-family: var(--font-body);
    font-size: 0.975rem;
    color: var(--colour-ink);
    background-color: var(--colour-paper);
    border: 1px solid var(--colour-line);
    border-radius: var(--radius-control);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--colour-gold);
    box-shadow: 0 0 0 3px rgba(223, 170, 53, 0.2);
    background-color: var(--colour-white);
  }

  .form-actions {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: 0.5rem;
  }

  .btn-submit-wa {
    width: 100%;
  }

  .form-disclaimer {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: var(--colour-muted);
    line-height: 1.4;
    margin-top: 0.5rem;
  }

  .form-disclaimer svg {
    flex-shrink: 0;
    margin-top: 2px;
  }
</style>

<script is:inline define:vars={{ whatsappNumber: siteData.whatsapp }}>
  document.addEventListener('DOMContentLoaded', () => {
    // URL parameter pre-selection check
    const urlParams = new URLSearchParams(window.location.search);
    const serviceParam = urlParams.get('service');
    const selectElem = document.getElementById('form-service');

    if (serviceParam && selectElem) {
      for (let i = 0; i < selectElem.options.length; i++) {
        if (selectElem.options[i].value.toLowerCase().includes(serviceParam.toLowerCase()) ||
            selectElem.options[i].text.toLowerCase().includes(serviceParam.toLowerCase())) {
          selectElem.selectedIndex = i;
          break;
        }
      }
    }

    const form = document.getElementById('whatsapp-quote-form');
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();

        const service = document.getElementById('form-service').value;
        const name = document.getElementById('form-name').value;
        const phone = document.getElementById('form-phone').value;
        const area = document.getElementById('form-area').value;
        const notes = document.getElementById('form-notes').value;

        let message = `Hello Gate & Guard Projects,\n\nI would like to request a quote for *${service}*.\n\n`;
        message += `*Name:* ${name}\n`;
        message += `*Phone:* ${phone}\n`;
        message += `*Area:* ${area}\n`;
        if (notes.trim()) {
          message += `*Notes:* ${notes}\n`;
        }

        const encodedMessage = encodeURIComponent(message);
        const waUrl = `https://wa.me/${whatsappNumber}?text=${encodedMessage}`;

        // Analytics tracking hook
        if (window.trackAnalyticsEvent) {
          window.trackAnalyticsEvent('quote_form_whatsapp_handoff', { service, area });
        }

        window.open(waUrl, '_blank', 'noopener,noreferrer');
      });
    }
  });
</script>
