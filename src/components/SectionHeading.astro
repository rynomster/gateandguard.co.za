---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  centered?: boolean;
  light?: boolean;
}

const { eyebrow, title, subtitle, centered = false, light = false } = Astro.props;
---

<div class:list={['section-heading-block', { centered, light }]}>
  {eyebrow && <span class="heading-eyebrow">{eyebrow}</span>}
  <h2 class="heading-title">{title}</h2>
  {subtitle && <p class="heading-subtitle">{subtitle}</p>}
</div>

<style>
  .section-heading-block {
    margin-bottom: 2.5rem;
  }

  .section-heading-block.centered {
    text-align: center;
  }

  .heading-eyebrow {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--colour-gold-dark);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .section-heading-block.light .heading-eyebrow {
    color: var(--colour-gold-bright);
  }

  .heading-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--colour-ink);
    letter-spacing: 0.02em;
    line-height: 1.1;
  }

  .section-heading-block.light .heading-title {
    color: var(--colour-white);
  }

  .heading-subtitle {
    font-size: 1.1rem;
    color: var(--colour-muted);
    max-width: 720px;
    margin-top: 0.75rem;
    line-height: 1.5;
  }

  .section-heading-block.centered .heading-subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .section-heading-block.light .heading-subtitle {
    color: var(--colour-silver);
  }
</style>
