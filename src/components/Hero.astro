---
import { siteData } from '../data/site';
import { assetRegistry } from '../data/assets';
import { path } from '../utils/paths';

interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
}

const {
  eyebrow = siteData.descriptor,
  title = "Your Property. Our Priority.",
  lead = "Precision gate automation, electric fencing, CCTV, and smart access control built for South African residential, estate, and commercial premises."
} = Astro.props;

const heroAsset = assetRegistry.heroBg;
---

<section class="hero-section">
  <!-- Hero Background Visual -->
  <div class="hero-media">
    <img
      src={path(heroAsset.path)}
      alt={heroAsset.alt}
      width="1920"
      height="1080"
      fetchpriority="high"
      loading="eager"
      class="hero-img"
    />
    <div class="hero-overlay-scrim"></div>
  </div>

  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span class="badge-text">{eyebrow}</span>
      </div>

      <h1 class="hero-title">{title}</h1>

      <p class="hero-lead">{lead}</p>

      <div class="hero-actions">
        <a href={path('/contact#quote')} class="btn-primary" data-analytics="quote_cta_click" data-placement="hero_primary">
          <span>Get a Quote</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <a href={path('/services')} class="btn-secondary" data-analytics="hero_explore_services">
          <span>Explore Services</span>
        </a>
      </div>

      <div class="hero-highlights">
        <div class="highlight-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--colour-gold-bright)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span>Battery Backup Ready</span>
        </div>
        <div class="highlight-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--colour-gold-bright)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span>Compliance &amp; EFSCOC Inspections</span>
        </div>
        <div class="highlight-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--colour-gold-bright)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span>Direct WhatsApp Quotes</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    background-color: var(--colour-ink);
    min-height: 80vh;
    display: flex;
    align-items: center;
    padding: 4.5rem 0 5rem 0;
    overflow: hidden;
    border-bottom: 2px solid var(--colour-gold);
  }

  @media (min-width: 992px) {
    .hero-section {
      min-height: 85vh;
      padding: 6rem 0 7rem 0;
    }
  }

  /* Media Background Layer */
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
    filter: brightness(0.85) contrast(1.05);
  }

  /* Gradient scrim ensuring 50/50 readability balance (Dark Left, Image Subject Right) */
  .hero-overlay-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(10, 14, 18, 0.96) 0%,
      rgba(10, 14, 18, 0.92) 42%,
      rgba(10, 14, 18, 0.65) 70%,
      rgba(10, 14, 18, 0.25) 100%
    );
  }

  @media (max-width: 768px) {
    .hero-overlay-scrim {
      background: linear-gradient(
        180deg,
        rgba(10, 14, 18, 0.94) 0%,
        rgba(10, 14, 18, 0.88) 60%,
        rgba(10, 14, 18, 0.96) 100%
      );
    }
  }

  .hero-container {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .hero-content {
    max-width: 720px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: rgba(223, 170, 53, 0.12);
    border: 1px solid rgba(223, 170, 53, 0.4);
    padding: 0.35rem 0.85rem;
    border-radius: 20px;
    margin-bottom: 1.5rem;
    backdrop-filter: blur(4px);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background-color: var(--colour-gold-bright);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--colour-gold-bright);
  }

  .badge-text {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--colour-gold-bright);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2.75rem, 6.2vw, 5.5rem);
    font-weight: 800;
    color: var(--colour-white);
    line-height: 1.02;
    letter-spacing: 0.01em;
    margin-bottom: 1.25rem;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }

  .hero-lead {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--colour-silver-light);
    line-height: 1.6;
    margin-bottom: 2.25rem;
    max-width: 640px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .hero-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--colour-line-dark);
  }

  .highlight-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--colour-silver-light);
    font-size: 0.925rem;
    font-weight: 500;
  }
</style>
