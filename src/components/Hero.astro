---
import { siteData } from '../data/site';

interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
}

const {
  eyebrow = siteData.descriptor,
  title = "Your Property. Our Priority.",
  lead = "Precision security, gate automation, and smart access control tailored for South African homes, estates, and business premises."
} = Astro.props;
---

<section class="hero-section">
  <div class="hero-bg-overlay"></div>
  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span class="badge-text">{eyebrow}</span>
      </div>

      <h1 class="hero-title">{title}</h1>

      <p class="hero-lead">{lead}</p>

      <div class="hero-actions">
        <a href="/contact#quote" class="btn-hero-primary">
          <span>Get a Quote</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <a href="/services" class="btn-hero-secondary">
          <span>View Services</span>
        </a>
      </div>

      <div class="hero-highlights">
        <div class="highlight-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--colour-gold-bright)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span>Battery Backup Ready</span>
        </div>
        <div class="highlight-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--colour-gold-bright)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span>Compliance & COC Available</span>
        </div>
        <div class="highlight-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--colour-gold-bright)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span>Direct WhatsApp Quotes</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    background-color: var(--colour-ink);
    background-image: radial-gradient(circle at 80% 20%, rgba(217, 154, 27, 0.12) 0%, transparent 40%),
                      linear-gradient(180deg, #0b0e10 0%, #151a1e 100%);
    padding: 4rem 0 5rem 0;
    overflow: hidden;
    border-bottom: 2px solid var(--colour-gold);
  }

  @media (min-width: 768px) {
    .hero-section {
      padding: 6rem 0 7rem 0;
    }
  }

  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(255, 255, 255, 0.015) 2px,
      rgba(255, 255, 255, 0.015) 4px
    );
    pointer-events: none;
  }

  .hero-container {
    position: relative;
    z-index: 2;
  }

  .hero-content {
    max-width: 820px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: rgba(217, 154, 27, 0.15);
    border: 1px solid var(--colour-gold);
    padding: 0.35rem 0.85rem;
    border-radius: 20px;
    margin-bottom: 1.5rem;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background-color: var(--colour-gold-bright);
    border-radius: 50%;
  }

  .badge-text {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--colour-gold-bright);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2.75rem, 6vw, 4.75rem);
    font-weight: 800;
    color: var(--colour-white);
    line-height: 1.05;
    letter-spacing: 0.01em;
    margin-bottom: 1.25rem;
  }

  .hero-lead {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--colour-silver-light);
    line-height: 1.6;
    margin-bottom: 2.25rem;
    max-width: 700px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background-color: var(--colour-gold);
    color: var(--colour-ink);
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.85rem 2rem;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-gold);
    transition: all var(--transition-fast);
  }

  .btn-hero-primary:hover {
    background-color: var(--colour-gold-bright);
    color: var(--colour-ink);
    transform: translateY(-2px);
  }

  .btn-hero-secondary {
    display: inline-flex;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.08);
    color: var(--colour-white);
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.85rem 1.75rem;
    border: 1px solid var(--colour-line-dark);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .btn-hero-secondary:hover {
    background-color: rgba(255, 255, 255, 0.15);
    border-color: var(--colour-silver);
    color: var(--colour-white);
  }

  .hero-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--colour-line-dark);
  }

  .highlight-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--colour-silver);
    font-size: 0.925rem;
    font-weight: 500;
  }
</style>
