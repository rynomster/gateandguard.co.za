---
import { siteData } from '../data/site';
import { servicesData } from '../data/services';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <!-- Brand Col -->
    <div class="footer-col brand-col">
      <a href="/" class="footer-logo">
        <img src="/assets/brand/logo-stacked.svg" alt="Gate & Guard Projects Logo" class="footer-logo-img" width="180" height="192" loading="lazy" />
      </a>
      <p class="brand-tagline">{siteData.tagline}</p>
      <p class="brand-desc">{siteData.descriptor}</p>
      <div class="brand-contact">
        <p><strong>Tel:</strong> <a href={`tel:${siteData.phone}`}>{siteData.phoneFormatted}</a></p>
        <p><strong>WhatsApp:</strong> <a href={`https://wa.me/${siteData.whatsapp}`} target="_blank" rel="noopener noreferrer">{siteData.whatsappFormatted}</a></p>
        <p><strong>Email:</strong> <a href={`mailto:${siteData.email}`}>{siteData.email}</a></p>
      </div>
    </div>

    <!-- Services Quick Links -->
    <div class="footer-col">
      <h3 class="footer-heading">Our Services</h3>
      <ul class="footer-links">
        {servicesData.map((svc) => (
          <li><a href={`/services/${svc.slug}`}>{svc.shortTitle}</a></li>
        ))}
      </ul>
    </div>

    <!-- Quick Navigation -->
    <div class="footer-col">
      <h3 class="footer-heading">Quick Links</h3>
      <ul class="footer-links">
        <li><a href="/about">About Gate & Guard</a></li>
        <li><a href="/services">All Security Services</a></li>
        <li><a href="/gallery">Completed Projects</a></li>
        <li><a href="/coc-certification">Electric Fence COC</a></li>
        <li><a href="/diy-projects">DIY Supply Kits</a></li>
        <li><a href="/contact">Contact & Quotes</a></li>
      </ul>
    </div>

    <!-- Service Areas & Operating Hours -->
    <div class="footer-col">
      <h3 class="footer-heading">Coverage & Hours</h3>
      <div class="footer-areas">
        <p class="area-title"><strong>Service Areas:</strong></p>
        <p class="area-list">{siteData.serviceAreas.join(', ')}</p>
      </div>
      <div class="footer-hours">
        <p class="hours-title"><strong>Operating Hours:</strong></p>
        <p>Mon - Fri: {siteData.businessHours.weekdays}</p>
        <p>Saturday: {siteData.businessHours.saturday}</p>
        <p>Emergency: {siteData.businessHours.emergency}</p>
      </div>
    </div>
  </div>

  <!-- Bottom Legal Strip -->
  <div class="footer-bottom">
    <div class="container bottom-inner">
      <p class="copyright">&copy; {currentYear} {siteData.companyName}. All Rights Reserved.</p>
      <p class="legal-note">Designed & Built for South African Residential & Commercial Security Excellence.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--colour-ink);
    color: var(--colour-silver);
    border-top: 3px solid var(--colour-gold);
    padding-top: 4rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
      gap: 3rem;
    }
  }

  .footer-logo-img {
    height: 120px;
    width: auto;
    margin-bottom: 1rem;
  }

  .brand-tagline {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--colour-gold-bright);
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }

  .brand-desc {
    font-size: 0.875rem;
    color: var(--colour-silver);
    margin-bottom: 1.25rem;
  }

  .brand-contact p {
    font-size: 0.9rem;
    margin-bottom: 0.35rem;
  }

  .brand-contact a {
    color: var(--colour-silver-light);
  }

  .brand-contact a:hover {
    color: var(--colour-gold-bright);
  }

  .footer-heading {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--colour-white);
    letter-spacing: 0.05em;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--colour-panel);
    position: relative;
  }

  .footer-heading::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 36px;
    height: 2px;
    background-color: var(--colour-gold);
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-links a {
    color: var(--colour-silver);
    font-size: 0.925rem;
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--colour-gold-bright);
    padding-left: 4px;
  }

  .footer-areas, .footer-hours {
    font-size: 0.875rem;
    margin-bottom: 1.25rem;
  }

  .area-title, .hours-title {
    color: var(--colour-white);
    margin-bottom: 0.35rem;
  }

  .area-list {
    line-height: 1.6;
    color: var(--colour-silver);
  }

  .footer-bottom {
    background-color: #060809;
    padding: 1.25rem 0;
    border-top: 1px solid var(--colour-line-dark);
    font-size: 0.8125rem;
    color: var(--colour-muted);
  }

  .bottom-inner {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    text-align: center;
  }

  @media (min-width: 768px) {
    .bottom-inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }
</style>
