---
import { siteData } from '../data/site';

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Need a Quote or Site Assessment?",
  subtitle = "Contact Gate & Guard Projects today for fast, expert advice and customized security solutions across Gauteng."
} = Astro.props;
---

<section class="quote-cta-section">
  <div class="container cta-inner">
    <div class="cta-content">
      <h2 class="cta-title">{title}</h2>
      <p class="cta-sub">{subtitle}</p>
    </div>

    <div class="cta-buttons">
      <a href={`https://wa.me/${siteData.whatsapp}?text=Hello%20Gate%20%26%20Guard%20Projects,%20I%20would%20like%20to%20request%20a%20quote.`} class="btn-cta-wa" target="_blank" rel="noopener noreferrer">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
        <span>WhatsApp Us</span>
      </a>

      <a href={`tel:${siteData.phone}`} class="btn-cta-call">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        <span>Call {siteData.phoneFormatted}</span>
      </a>

      <a href="/contact#quote" class="btn-cta-form">
        <span>Request Form</span>
      </a>
    </div>
  </div>
</section>

<style>
  .quote-cta-section {
    background-color: var(--colour-charcoal);
    background-image: radial-gradient(circle at 10% 50%, rgba(217, 154, 27, 0.1) 0%, transparent 50%);
    border-top: 3px solid var(--colour-gold);
    border-bottom: 3px solid var(--colour-gold);
    padding: 3.5rem 0;
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: center;
    text-align: center;
  }

  @media (min-width: 992px) {
    .cta-inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .cta-content {
    max-width: 680px;
  }

  .cta-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    color: var(--colour-white);
    letter-spacing: 0.02em;
    line-height: 1.1;
    margin-bottom: 0.5rem;
  }

  .cta-sub {
    font-size: 1.05rem;
    color: var(--colour-silver);
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    justify-content: center;
  }

  .btn-cta-wa {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #25d366;
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
  }

  .btn-cta-wa:hover {
    background-color: #1eb956;
    color: #ffffff;
  }

  .btn-cta-call {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--colour-gold);
    color: var(--colour-ink);
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-sm);
  }

  .btn-cta-call:hover {
    background-color: var(--colour-gold-bright);
    color: var(--colour-ink);
  }

  .btn-cta-form {
    display: inline-flex;
    align-items: center;
    background-color: transparent;
    color: var(--colour-white);
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--colour-silver);
    border-radius: var(--radius-sm);
  }

  .btn-cta-form:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: var(--colour-white);
  }
</style>
